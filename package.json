{
  "name": "open-reverse",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Reverse engineering in the browser, powered by OpenDecomp running client-side",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node test/e2e/browser.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "1.1.5",
    "@noble/hashes": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tanstack/react-virtual": "3.13.12",
    "@types/node": "24.10.1",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
