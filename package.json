{
  "name": "open-reverse",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Web UI for reverse engineering native binaries, powered by OpenDecomp",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "open-reverse": "./server/main.ts"
  },
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch server/main.ts --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "fastify": "5.6.2",
    "open-decomp": "file:vendor/open-decomp"
  },
  "devDependencies": {
    "@dagrejs/dagre": "1.1.5",
    "@tanstack/react-virtual": "3.13.12",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
