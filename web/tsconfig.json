{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable",
      "webworker"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@od/*": [
        "../vendor/open-decomp/dist/src/*"
      ],
      "@odm/*": [
        "../vendor/open-decomp/node_modules/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}